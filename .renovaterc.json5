{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'abandonments:recommended',
    'github>home-operations/renovate-presets#11.0.0',
  ],
  labels: [
    'dependencies',
  ],
  dependencyDashboard: {
    footer: '- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository',
  },
  packageRules: [
    {
      matchPackageNames: [
        '*',
      ],
      automerge: false,
      semanticCommitType: 'chore',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
    },
    {
      // Merge the llama.cpp image bump without approval once the PR checks pass.
      // The preset uses branch automerge, which skips the PR and so skips the PR-only lint workflow.
      matchFileNames: [
        'dev/compose.yaml',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      // shuck pushes a git tag before (or without) its GitHub release, and mise installs only released versions.
      // Look versions up in releases so Renovate never proposes a tag-only version like 0.2.9.
      matchManagers: [
        'mise',
      ],
      matchPackageNames: [
        'ewhauser/shuck',
      ],
      overrideDatasource: 'github-releases',
    },
  ],
}
